{
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.venv",
    "**/node_modules",
    "**/.git",
    "examples",
    "scripts"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": "none",
  "pythonVersion": "3.14",
  "pythonPlatform": "Darwin",
  "typeCheckingMode": "basic",
  "stubPath": "",
  "extraPaths": [
    "src"
  ]
}

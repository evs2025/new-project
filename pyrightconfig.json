{
  "include": [
    "src",
    "tests",
    "examples",
    "scripts"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.venv",
    "**/node_modules",
    "**/.git"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": false,
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": false,
  "pythonVersion": "3.14",
  "pythonPlatform": "Darwin",
  "typeCheckingMode": "basic"
}

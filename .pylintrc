[MASTER]
# Disable Pylint completely in VS Code
# Use Ruff (make lint) and Pylance instead
jobs=1
persistent=yes

[MESSAGES CONTROL]
# Disable ALL checks - Pylint in VS Code doesn't respect config properly
disable=all

[DESIGN]
# Maximum number of arguments for function / method
max-args=7

# Maximum number of attributes for a class
max-attributes=10

[FORMAT]
# Maximum number of characters on a single line
max-line-length=100

[IMPORTS]
# Allow wildcard imports
allow-wildcard-with-all=no

[MASTER]
# Use multiple processes to speed up Pylint
jobs=1

# Pickle collected data for later comparisons
persistent=yes

[MESSAGES CONTROL]
# Disable specific warnings
disable=
    C0303,  # trailing-whitespace (handled by black)
    C0413,  # wrong-import-position (examples need sys.path modification)
    E0401,  # import-error (handled by tests/runtime)
    W0611,  # unused-import (in progress)
    W1203,  # logging-fstring-interpolation (modern style)
    W0718,  # broad-exception-caught (intentional in CLI)
    C0116,  # missing-function-docstring (tests don't need docstrings)
    C0305,  # trailing-newlines (handled by black)

[REPORTS]
# Set the output format
output-format=text

# Tells whether to display a full report or only the messages
reports=no

[BASIC]
# Good variable names
good-names=i,j,k,ex,Run,_,logger

[DESIGN]
# Maximum number of arguments for function / method
max-args=7

# Maximum number of attributes for a class
max-attributes=10

[FORMAT]
# Maximum number of characters on a single line
max-line-length=100

[IMPORTS]
# Allow wildcard imports
allow-wildcard-with-all=no
